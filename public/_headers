/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
/sw.js
  Cache-Control: no-cache
/admin/*
  X-Robots-Tag: noindex, nofollow
